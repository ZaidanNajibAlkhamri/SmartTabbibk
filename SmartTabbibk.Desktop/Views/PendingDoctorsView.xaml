<UserControl x:Class="SmartTabbibk.Desktop.Views.PendingDoctorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
            <Button Content="تحديث القائمة" Style="{StaticResource OutlineButton}"
                    Command="{Binding RefreshCommand}" Margin="0,0,10,0"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource ColorTextSecondary}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <DataGrid ItemsSource="{Binding Doctors}" AutoGenerateColumns="False"
                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  RowHeight="42" Background="{StaticResource ColorSurface}"
                  BorderBrush="{StaticResource ColorBorder}" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="التخصص" Binding="{Binding SpecialtyName}" Width="150"/>
                <DataGridTextColumn Header="سعر الكشف" Binding="{Binding ConsultationFee}" Width="100"/>
                <DataGridTemplateColumn Header="" Width="220">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="اعتماد" Style="{StaticResource PrimaryButton}"
                                        Margin="0,4,6,4" Click="Approve_Click"/>
                                <Button Content="رفض" Style="{StaticResource DangerButton}"
                                        Margin="0,4,0,4" Click="Reject_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
