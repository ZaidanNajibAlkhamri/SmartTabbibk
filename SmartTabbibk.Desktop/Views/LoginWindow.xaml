<Window x:Class="SmartTabbibk.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="طبيبك الذكي - تسجيل الدخول" Height="420" Width="380"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{StaticResource ColorBackground}"
        FontFamily="Segoe UI">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="طبيبك الذكي" FontSize="22" FontWeight="Bold"
                   Foreground="{StaticResource ColorPrimary}" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Text="لوحة الإدارة" FontSize="13"
                   Foreground="{StaticResource ColorTextSecondary}" Margin="0,0,0,24"/>

        <TextBlock Grid.Row="2" Text="البريد الإلكتروني" FontSize="12"
                   Foreground="{StaticResource ColorTextSecondary}" Margin="0,0,0,4"/>
        <TextBox Grid.Row="2" Margin="0,20,0,10" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="3" Text="كلمة المرور" FontSize="12"
                   Foreground="{StaticResource ColorTextSecondary}" Margin="0,0,0,4"/>
        <PasswordBox Grid.Row="3" x:Name="PasswordBox" Padding="8" Margin="0,20,0,10"
                     BorderBrush="{StaticResource ColorBorder}"
                     PasswordChanged="PasswordBox_PasswordChanged"/>

        <TextBlock Grid.Row="4" Text="{Binding ErrorMessage}" Foreground="{StaticResource ColorDanger}"
                   TextWrapping="Wrap" Margin="0,0,0,10"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

        <Button Grid.Row="5" Content="دخول" Style="{StaticResource PrimaryButton}"
                Command="{Binding LoginCommand}" HorizontalAlignment="Stretch" Height="38"/>

        <TextBlock Grid.Row="6" Text="جارِ الدخول..." Foreground="{StaticResource ColorTextSecondary}"
                   HorizontalAlignment="Center" Margin="0,10,0,0"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
    </Grid>
</Window>
