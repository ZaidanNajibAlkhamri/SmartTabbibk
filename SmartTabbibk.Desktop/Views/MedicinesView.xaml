<UserControl x:Class="SmartTabbibk.Desktop.Views.MedicinesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource ColorSurface}"
                BorderBrush="{StaticResource ColorBorder}" BorderThickness="1" Padding="14" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="إضافة دواء جديد" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Margin="0,0,10,0" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                             Tag="اسم الدواء"/>
                    <TextBox Grid.Column="1" Margin="0,0,10,0" Text="{Binding NewStrength, UpdateSourceTrigger=PropertyChanged}"
                             Tag="التركيز"/>
                    <ComboBox Grid.Column="2" Margin="0,0,10,0" SelectedValue="{Binding NewForm}" SelectedValuePath="Content">
                        <ComboBoxItem Content="Tablet"/>
                        <ComboBoxItem Content="Capsule"/>
                        <ComboBoxItem Content="Syrup"/>
                        <ComboBoxItem Content="Injection"/>
                    </ComboBox>
                    <Button Grid.Column="3" Content="إضافة" Style="{StaticResource PrimaryButton}"
                            Command="{Binding AddCommand}"/>
                </Grid>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource ColorDanger}" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <DataGrid ItemsSource="{Binding Medicines}" AutoGenerateColumns="False"
                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  RowHeight="42" Background="{StaticResource ColorSurface}"
                  BorderBrush="{StaticResource ColorBorder}" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="التركيز" Binding="{Binding Strength}" Width="100"/>
                <DataGridTextColumn Header="الشكل" Binding="{Binding Form}" Width="100"/>
                <DataGridTextColumn Header="الحالة" Binding="{Binding IsActive, Converter={StaticResource BoolToActiveTextConverter}}" Width="80"/>
                <DataGridTemplateColumn Header="" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="تبديل الحالة" Style="{StaticResource OutlineButton}"
                                    Margin="0,4" Click="ToggleActive_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
