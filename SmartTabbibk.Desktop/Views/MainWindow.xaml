<Window x:Class="SmartTabbibk.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SmartTabbibk.Desktop.Views"
        Title="طبيبك الذكي - لوحة الإدارة" Height="620" Width="900"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{StaticResource ColorBackground}"
        FontFamily="Segoe UI">

    <DockPanel>
        <!-- الشريط العلوي: اسم المستخدم -->
        <Border DockPanel.Dock="Top" Background="{StaticResource ColorSurface}"
                BorderBrush="{StaticResource ColorBorder}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <TextBlock Text="طبيبك الذكي — لوحة الإدارة" FontWeight="Bold" FontSize="16"
                           Foreground="{StaticResource ColorPrimary}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding CurrentUser.Name}" HorizontalAlignment="Left"
                           VerticalAlignment="Center" Foreground="{StaticResource ColorTextSecondary}"/>
            </Grid>
        </Border>

        <TabControl Margin="20" SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="اعتماد الأطباء">
                <views:PendingDoctorsView DataContext="{Binding PendingDoctorsVM}"/>
            </TabItem>
            <TabItem Header="إدارة الأدوية">
                <views:MedicinesView DataContext="{Binding MedicinesVM}"/>
            </TabItem>
            <TabItem Header="إدارة التخصصات">
                <views:SpecialtiesView DataContext="{Binding SpecialtiesVM}"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
