<UserControl x:Class="SmartTabbibk.Desktop.Views.SpecialtiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource ColorSurface}"
                BorderBrush="{StaticResource ColorBorder}" BorderThickness="1" Padding="14" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="إضافة تخصص جديد" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Margin="0,0,10,0" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Grid.Column="1" Margin="0,0,10,0" Text="{Binding NewKeywords, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="2" Content="إضافة" Style="{StaticResource PrimaryButton}"
                            Command="{Binding AddCommand}"/>
                </Grid>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource ColorDanger}"
                           TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <DataGrid ItemsSource="{Binding Specialties}" AutoGenerateColumns="False"
                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  RowHeight="42" Background="{StaticResource ColorSurface}"
                  BorderBrush="{StaticResource ColorBorder}" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="الرقم" Binding="{Binding SpecialtyId}" Width="80"/>
                <DataGridTextColumn Header="اسم التخصص" Binding="{Binding Name}" Width="*"/>
                <DataGridTemplateColumn Header="" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="حذف" Style="{StaticResource DangerButton}"
                                    Margin="0,4" Click="Delete_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
