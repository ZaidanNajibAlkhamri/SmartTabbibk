<Application x:Class="SmartTabbibk.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SmartTabbibk.Desktop.Converters"
             StartupUri="Views/LoginWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:BoolToActiveTextConverter x:Key="BoolToActiveTextConverter"/>

            <!-- نفس لوحة الألوان الطبية الهادئة المستخدمة في نسخة React بالظبط -->
            <SolidColorBrush x:Key="ColorPrimary" Color="#0E6E67"/>
            <SolidColorBrush x:Key="ColorPrimaryHover" Color="#0B5951"/>
            <SolidColorBrush x:Key="ColorBackground" Color="#F6F8F9"/>
            <SolidColorBrush x:Key="ColorSurface" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ColorBorder" Color="#DCE3E6"/>
            <SolidColorBrush x:Key="ColorText" Color="#172327"/>
            <SolidColorBrush x:Key="ColorTextSecondary" Color="#5B6B72"/>
            <SolidColorBrush x:Key="ColorDanger" Color="#B3261E"/>
            <SolidColorBrush x:Key="ColorSuccess" Color="#2E7D5B"/>

            <Style TargetType="Button" x:Key="PrimaryButton">
                <Setter Property="Background" Value="{StaticResource ColorPrimary}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource ColorPrimaryHover}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="Button" x:Key="OutlineButton">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource ColorText}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>

            <Style TargetType="Button" x:Key="DangerButton">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource ColorDanger}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ColorDanger}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Padding" Value="8"/>
                <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
