<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationTitle>طبيبك الذكي - لوحة الإدارة</ApplicationTitle>
  </PropertyGroup>

  <!--
    لا حاجة لأي NuGet Packages خارجية — الكل مبني على:
    - System.Net.Http (مدمجة في .NET) للاتصال بالـ API
    - System.Text.Json (مدمجة في .NET) لتحويل JSON
    - MVVM يدوي بسيط (ViewModelBase + RelayCommand) بدون مكتبات خارجية
    هذا يقلل مخاطر مشاكل NuGet Restore التي واجهناها سابقاً في المشروع
  -->

</Project>
